<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================================================
         ACTION DU RAPPORT
    ========================================================== -->
    <record id="action_report_calculatrice" model="ir.actions.report">
        <field name="name">Calculatrice</field>
        <field name="model">calculatrice.calculatrice</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">calculatrice.report_calculatrice</field>
        <field name="report_file">calculatrice.report_calculatrice</field>
        <field name="print_report_name">'Calculatrice - %s' % (object.id)</field>
    </record>


    <!-- =========================================================
         TEMPLATE QWEB
    ========================================================== -->
    <template id="report_calculatrice">

        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="o">

                <t t-call="web.external_layout">

                    <div class="page">

                        <!-- =================================================
                             EN-TÊTE
                        ================================================== -->
                        <div class="row mb-4">

                            <div class="col-8">
                                <h2 style="
                                    margin-bottom: 4px;
                                    font-weight: 700;
                                ">
                                    Calculatrice
                                </h2>

                                <div style="
                                    color: #6c757d;
                                    font-size: 14px;
                                ">
                                    Rapport de calcul
                                </div>
                            </div>

                            <div class="col-4 text-end">
                                <div style="
                                    display: inline-block;
                                    padding: 7px 14px;
                                    border-radius: 20px;
                                    background-color: #f1f3f5;
                                    color: #495057;
                                    font-size: 12px;
                                    font-weight: 600;
                                ">
                                    RAPPORT DE CALCUL
                                </div>
                            </div>

                        </div>


                        <!-- =================================================
                             INFORMATIONS DU CALCUL
                        ================================================== -->
                        <div style="
                            border: 1px solid #dee2e6;
                            border-radius: 10px;
                            overflow: hidden;
                            margin-bottom: 25px;
                        ">

                            <!-- Titre -->
                            <div style="
                                padding: 12px 18px;
                                background-color: #f8f9fa;
                                border-bottom: 1px solid #dee2e6;
                            ">
                                <strong style="
                                    font-size: 15px;
                                ">
                                    Détails du calcul
                                </strong>
                            </div>

                            <!-- Corps -->
                            <div style="
                                padding: 20px;
                            ">

                                <div class="row">

                                    <div class="col-4">
                                        <div style="
                                            color: #6c757d;
                                            font-size: 12px;
                                            margin-bottom: 5px;
                                        ">
                                            Nombre 1
                                        </div>

                                        <strong style="font-size: 17px;">
                                            <span t-field="o.nombre1"/>
                                        </strong>
                                    </div>


                                    <div class="col-4">
                                        <div style="
                                            color: #6c757d;
                                            font-size: 12px;
                                            margin-bottom: 5px;
                                        ">
                                            Opération
                                        </div>

                                        <strong style="font-size: 17px;">
                                            <span t-field="o.operation"/>
                                        </strong>
                                    </div>


                                    <div class="col-4">
                                        <div style="
                                            color: #6c757d;
                                            font-size: 12px;
                                            margin-bottom: 5px;
                                        ">
                                            Nombre 2
                                        </div>

                                        <strong style="font-size: 17px;">
                                            <span t-field="o.nombre2"/>
                                        </strong>
                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- =================================================
                             EXPRESSION DU CALCUL
                        ================================================== -->
                        <div style="
                            text-align: center;
                            margin: 30px 0;
                        ">

                            <div style="
                                color: #6c757d;
                                font-size: 12px;
                                text-transform: uppercase;
                                letter-spacing: 1px;
                                margin-bottom: 12px;
                            ">
                                Expression du calcul
                            </div>

                            <div style="
                                font-size: 25px;
                                font-weight: 600;
                                padding: 20px;
                                border-radius: 10px;
                                background-color: #f8f9fa;
                                border: 1px solid #e9ecef;
                            ">

                                <span t-field="o.nombre1"/>

                                <span style="
                                    margin: 0 12px;
                                    color: #6c757d;
                                ">

                                    <t t-if="o.operation == 'addition'">+</t>
                                    <t t-elif="o.operation == 'soustraction'">−</t>
                                    <t t-elif="o.operation == 'multiplication'">×</t>
                                    <t t-elif="o.operation == 'division'">÷</t>
                                    <t t-elif="o.operation == 'modulo'">%</t>
                                    <t t-elif="o.operation == 'pgcd'">PGCD</t>

                                </span>

                                <span t-field="o.nombre2"/>

                            </div>

                        </div>


                        <!-- =================================================
                             RÉSULTAT
                        ================================================== -->
                        <div style="
                            margin: 30px 0;
                            padding: 25px;
                            border-radius: 12px;
                            background-color: #f8f9fa;
                            border: 1px solid #dee2e6;
                            text-align: center;
                        ">

                            <div style="
                                color: #6c757d;
                                font-size: 12px;
                                text-transform: uppercase;
                                letter-spacing: 1px;
                                margin-bottom: 8px;
                            ">
                                Résultat
                            </div>

                            <div style="
                                font-size: 36px;
                                font-weight: 700;
                            ">
                                <span t-field="o.resultat"/>
                            </div>

                        </div>


                        <!-- =================================================
                             CONTACTS
                        ================================================== -->
                        <div style="
                            margin-top: 30px;
                        ">

                            <h4 style="
                                font-size: 15px;
                                font-weight: 600;
                                border-bottom: 1px solid #dee2e6;
                                padding-bottom: 8px;
                                margin-bottom: 12px;
                            ">
                                Contacts associés
                            </h4>

                            <t t-if="o.contact_ids">

                                <table class="table table-sm"
                                       style="
                                           margin-bottom: 0;
                                           border: 1px solid #dee2e6;
                                       ">

                                    <thead style="
                                        background-color: #f8f9fa;
                                    ">
                                        <tr>
                                            <th style="padding: 9px;">
                                                Nom
                                            </th>

                                            <th style="padding: 9px;">
                                                Email
                                            </th>

                                            <th style="padding: 9px;">
                                                Téléphone
                                            </th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        <tr t-foreach="o.contact_ids"
                                            t-as="contact">

                                            <td style="padding: 9px;">
                                                <span t-field="contact.name"/>
                                            </td>

                                            <td style="padding: 9px;">
                                                <span t-field="contact.email"/>
                                            </td>

                                            <td style="padding: 9px;">
                                                <span t-field="contact.phone"/>
                                            </td>

                                        </tr>

                                    </tbody>

                                </table>

                            </t>

                            <t t-else="">

                                <div style="
                                    padding: 12px;
                                    background-color: #f8f9fa;
                                    border: 1px solid #dee2e6;
                                    border-radius: 6px;
                                    color: #6c757d;
                                ">
                                    Aucun contact lié.
                                </div>

                            </t>

                        </div>


                        <!-- =================================================
                             INFORMATIONS DU RAPPORT
                        ================================================== -->
                        <div style="
                            margin-top: 35px;
                            padding-top: 12px;
                            border-top: 1px solid #dee2e6;
                            color: #6c757d;
                            font-size: 11px;
                        ">

                            <div class="row">

                                <div class="col-6">
                                    Rapport généré automatiquement par Odoo
                                </div>

                                <div class="col-6 text-end">
                                    <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/>
                                </div>

                            </div>

                        </div>

                    </div>

                </t>

            </t>

        </t>

    </template>

</odoo>